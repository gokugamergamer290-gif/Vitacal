rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Domain validation helpers
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             data.displayName is string &&
             data.displayName.size() <= 100 &&
             data.dailyCalorieGoal is int &&
             data.dailyCalorieGoal >= 500 &&
             data.dailyCalorieGoal <= 10000 &&
             data.proteinGoalG is int &&
             data.proteinGoalG >= 10 &&
             data.proteinGoalG <= 600 &&
             data.carbsGoalG is int &&
             data.carbsGoalG >= 10 &&
             data.carbsGoalG <= 1000 &&
             data.fatGoalG is int &&
             data.fatGoalG >= 10 &&
             data.fatGoalG <= 400 &&
             data.waterGoalMl is int &&
             data.waterGoalMl >= 500 &&
             data.waterGoalMl <= 10000 &&
             data.weightKg is number &&
             data.weightKg >= 20 &&
             data.weightKg <= 400 &&
             data.heightCm is int &&
             data.heightCm >= 80 &&
             data.heightCm <= 260 &&
             data.age is int &&
             data.age >= 10 &&
             data.age <= 120 &&
             data.sex in ['M', 'F'] &&
             data.activityLevel in ['sedentary', 'light', 'moderate', 'active'] &&
             data.goalType in ['lose', 'maintain', 'gain'];
    }

    function isValidMealEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             isValidDateKey(data.dateKey) &&
             data.mealType in ['breakfast', 'lunch', 'dinner', 'snack'] &&
             data.foodName is string &&
             data.foodName.size() >= 1 &&
             data.foodName.size() <= 120 &&
             data.servingLabel is string &&
             data.servingLabel.size() >= 1 &&
             data.servingLabel.size() <= 80 &&
             data.servings is number &&
             data.servings > 0 &&
             data.servings <= 100 &&
             data.calories is int &&
             data.calories >= 0 &&
             data.calories <= 10000 &&
             data.proteinG is number &&
             data.proteinG >= 0 &&
             data.proteinG <= 1000 &&
             data.carbsG is number &&
             data.carbsG >= 0 &&
             data.carbsG <= 1000 &&
             data.fatG is number &&
             data.fatG >= 0 &&
             data.fatG <= 1000;
    }

    function isValidWaterLog(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             isValidDateKey(data.dateKey) &&
             data.amountMl is int &&
             data.amountMl >= 0 &&
             data.amountMl <= 20000;
    }

    function isValidCustomFood(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(data.userId) &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 120 &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 40 &&
             data.servingLabel is string &&
             data.servingLabel.size() >= 1 &&
             data.servingLabel.size() <= 80 &&
             data.calories is int &&
             data.calories >= 0 &&
             data.calories <= 10000 &&
             data.proteinG is number &&
             data.proteinG >= 0 &&
             data.proteinG <= 1000 &&
             data.carbsG is number &&
             data.carbsG >= 0 &&
             data.carbsG <= 1000 &&
             data.fatG is number &&
             data.fatG >= 0 &&
             data.fatG <= 1000;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'dailyCalorieGoal', 'proteinGoalG',
                         'carbsGoalG', 'fatGoalG', 'waterGoalMl', 'weightKg',
                         'heightCm', 'age', 'sex', 'activityLevel', 'goalType',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'dailyCalorieGoal', 'proteinGoalG',
                         'carbsGoalG', 'fatGoalG', 'waterGoalMl', 'weightKg',
                         'heightCm', 'age', 'sex', 'activityLevel', 'goalType',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'dailyCalorieGoal', 'proteinGoalG',
                         'carbsGoalG', 'fatGoalG', 'waterGoalMl', 'weightKg',
                         'heightCm', 'age', 'sex', 'activityLevel', 'goalType',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /meal_entries/{entryId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(entryId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(entryId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'mealType', 'foodName', 'servingLabel',
                           'servings', 'calories', 'proteinG', 'carbsG', 'fatG',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'mealType', 'foodName', 'servingLabel',
                           'servings', 'calories', 'proteinG', 'carbsG', 'fatG',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidMealEntry(incoming());

        allow update: if isSignedIn() &&
                         isValidMealEntry(incoming()) &&
                         isValidId(userId) &&
                         isValidId(entryId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'dateKey', 'mealType', 'foodName', 'servingLabel',
                           'servings', 'calories', 'proteinG', 'carbsG', 'fatG',
                           'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(entryId) && request.auth.uid == userId;
      }

      match /water_logs/{dateKey} {
        allow get: if isSignedIn() && isValidId(userId) && isValidDateKey(dateKey) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidDateKey(dateKey) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().dateKey == dateKey &&
                         incoming().keys().hasAll(['userId', 'dateKey', 'amountMl', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dateKey', 'amountMl', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidWaterLog(incoming());

        allow update: if isSignedIn() &&
                         isValidWaterLog(incoming()) &&
                         isValidId(userId) &&
                         isValidDateKey(dateKey) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['amountMl', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidDateKey(dateKey) && request.auth.uid == userId;
      }

      match /custom_foods/{foodId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(foodId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(foodId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'category', 'servingLabel',
                           'calories', 'proteinG', 'carbsG', 'fatG',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'category', 'servingLabel',
                           'calories', 'proteinG', 'carbsG', 'fatG',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidCustomFood(incoming());

        allow update: if isSignedIn() &&
                         isValidCustomFood(incoming()) &&
                         isValidId(userId) &&
                         isValidId(foodId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'category', 'servingLabel',
                           'calories', 'proteinG', 'carbsG', 'fatG',
                           'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(foodId) && request.auth.uid == userId;
      }
    }
  }
}
